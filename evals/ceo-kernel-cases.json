[
  {
    "id": "crm_is_solution_not_problem",
    "title": "CRM is treated as proposed solution, not the real problem",
    "turns": [
      "Нам нужна CRM"
    ],
    "expected": {
      "intentIntegrity": {
        "type": "proposed_solution",
        "mustReframe": true,
        "underlyingProblemRequired": true
      },
      "referenceGate": {
        "mustTrigger": true,
        "candidateLayers": ["technology", "commercial", "data_analytics", "operating_model"],
        "minimumReferenceNeeded": [
          "какую проблему должна решить CRM",
          "как сейчас проходит заявка или клиент",
          "что именно теряется без системы"
        ]
      },
      "dataBehavior": {
        "mustSearchExistingContextFirst": true,
        "maxUserQuestions": 1
      },
      "responseChecks": {
        "mustContainAny": [
          "ты предлагаешь инструмент",
          "это уже вариант решения",
          "сначала зафиксируем проблему",
          "какую проблему он должен решить"
        ],
        "mustNotContain": [
          "CRM вам точно нужна",
          "внедрите CRM",
          "начните с выбора CRM",
          "11 слоев",
          "A-D"
        ],
        "requireQuestion": true,
        "maxParagraphs": 3,
        "maxChars": 1200
      }
    }
  },
  {
