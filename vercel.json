{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "functions": {
    "api/telegram.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/mini-app/:first/:rest*",
      "destination": "/api/mini-app/rpc?path=:first/:rest*"
    },
    {
      "source": "/mini-app",
      "destination": "/mini-app/index.html"
    },
    {
      "source": "/mini-app/:path*",
      "destination": "/mini-app/index.html"
    }
  ]
}
